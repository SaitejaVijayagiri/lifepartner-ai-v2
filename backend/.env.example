# ============================================================
# LifePartner AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# ALL variables marked [REQUIRED] must be set or the server will refuse to start.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development           # development | production

# ── Database ────────────────────────────────────────────────
# [REQUIRED] Supabase or self-hosted Postgres connection string
DATABASE_URL=postgres://user:pass@localhost:5432/lifepartner

# ── Authentication ──────────────────────────────────────────
# [REQUIRED] Strong random secret for signing JWTs (min 32 chars recommended)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_string

# ── Frontend ─────────────────────────────────────────────────
# URL of the web app (used in CORS, email links, payment return URLs)
FRONTEND_URL=http://localhost:3005

# Backend public URL (used for image proxy URLs sent in API responses)
BACKEND_URL=http://localhost:4000

# Comma-separated list of additional allowed CORS origins (optional)
# EXTRA_ALLOWED_ORIGINS=https://staging.lifepartnerai.in,https://app.lifepartnerai.in

# ── AI Services ──────────────────────────────────────────────
# Google Gemini — free tier at https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: OpenAI (fallback embeddings / completions)
OPENAI_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────
# Get a free API key at https://resend.com/
RESEND_API_KEY=re_xxxx_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender address configured in your Resend dashboard
EMAIL_FROM=LifePartner AI <noreply@lifepartnerai.in>

# ── Payments (Cashfree) ──────────────────────────────────────
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# TEST uses Cashfree sandbox; set to PROD for live payments
CASHFREE_ENV=TEST

# ── Supabase Storage ─────────────────────────────────────────
# Used for profile photo uploads. Get keys from your Supabase project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=

# ── Firebase (Push Notifications) ───────────────────────────
# Option 1 (recommended for production): Paste the entire JSON content of your
# Firebase Admin SDK service account as a single-line JSON string.
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}

# Option 2 (local dev): Place firebase-service-account.json file in the backend/ directory.
# The server will auto-detect it. Do NOT commit this file to git.

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ── Twilio (OTP SMS) ─────────────────────────────────────────
# Optional: used for phone OTP verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
